  "description": "A free canvas for process maps and flowcharts. Drag shapes from the left, then connect them with arrows.",
  "layout": {
    "type": "free"
  },
  "zones": [],
  "palette": [
    "process",
    "decision",
    "terminator",
    "data",
    "document",
    "subprocess",
    "database",
    "note",
    "circle",
    "text",
    "server",
    "cloud",
    "queue",
    "service",
    "browser",
    "mobile",
    "actor"
  ],
  "shapes": {
    "item": {
      "defaultLabel": "Step",
      "defaultShape": "process",
      "fields": [
        {
          "key": "owner",
