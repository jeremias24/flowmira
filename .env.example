# Copy to .env and change the password before deploying
POSTGRES_DB=flowmira
POSTGRES_USER=flowmira
POSTGRES_PASSWORD=rootpass
APP_PORT=8080

# ERD module: which database servers may be inspected (comma separated).
# Empty = any server reachable from Flowmira (cloud metadata addresses are always blocked).
# Examples: db.company.local, *.company.local, 10.0.0.0/8, host.docker.internal
ERD_ALLOWED_HOSTS=
