# Copy to .env and change the password before deploying
POSTGRES_DB=flowmira
POSTGRES_USER=flowmira
POSTGRES_PASSWORD=rootpass
APP_PORT=8080

# ERD module: which database servers may be inspected (comma separated).
# Empty = any server reachable from Flowmira (cloud metadata addresses are always blocked).
# Examples: db.company.local, *.company.local, 10.0.0.0/8, host.docker.internal
ERD_ALLOWED_HOSTS=

# ── NEW ── Sign-in through the IPC portal / UMS
# The address people open Flowmira at (no trailing slash). Production: https://<flowmira-host>
APP_ORIGIN=http://localhost:8080
# UMS API base, the part before /authenticate/... and /verify_api_token.
# Local UMS (ums-nginx on :8001): http://host.docker.internal:8001/api/v1
UMS_AUTH_URL=http://host.docker.internal:8001/api/v1
UMS_TIMEOUT=10
# How often a signed-in user's access is read again (minutes)
ACCESS_RECHECK_MINUTES=5
# ── FIX ── Access comes from CALL ipc_centralized.sp_user_system_active_accesses
# (user_id, employee_id, user_class_id); UMS supplies identity.
# Sessions remain read-only. Use an EXECUTE-only account after confirming the procedure
# is read-only and its SQL SECURITY / definer permissions permit execution:
#   CREATE USER 'flowmira_ro'@'%' IDENTIFIED BY '...';
#   GRANT EXECUTE ON PROCEDURE ipc_centralized.sp_user_system_active_accesses TO 'flowmira_ro'@'%';
# Local MySQL (container "mysql", port 3306 on the host): IPC_DB_HOST=host.docker.internal
IPC_DB_HOST=host.docker.internal
IPC_DB_PORT=3306
IPC_DB_NAME=ipc_centralized
IPC_DB_USER=root
IPC_DB_PASSWORD=change-me
FLOWMIRA_SYSTEM_CODE=SYS-222-FM
# ipc_centralized user types: 2 Super User, 3 System Owner -> everything;
# 5 Regular User, 13 Administrator -> diagrams only. Anything else is refused.
FLOWMIRA_OWNER_TYPE_IDS=2,3
FLOWMIRA_USER_TYPE_IDS=5,13
# Sign-in lasts at most this long (hours)
SESSION_HOURS=8
# 1 = cookie only over https (production). 0 only for plain-http testing on another
# machine; http://localhost works with 1 in current browsers.
COOKIE_SECURE=1

# ── NEW ── Required. Encrypts diagram and ERD ids in addresses (/flowmira/diagram/<encrypted>).
# 64 random bytes, base64url; the same value is used by the backend and the ERD service.
# Changing it changes every address (old bookmarks stop working; no data is affected). Make one with:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(64)).decode())"
FLOWMIRA_ID_KEY=
